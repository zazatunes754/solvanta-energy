# Dependencies — installed with `npm ci` / `npm install`, never committed.
node_modules/

# Build output — regenerated by `npm run build`; GitHub Actions builds its own
# copy from source, so the tree stays clean of disposable artifacts.
dist/

# Playwright QA evidence is intentionally refreshed per run; keep the folder,
# but images regenerating from every qa sweep are not worth tracking conflicts.
qa/qa-results.json

# OS / editor noise
Thumbs.db
.DS_Store
*.log
